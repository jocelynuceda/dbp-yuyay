# Copiar a .env (nunca commitear .env). En EC2 se cargan con --env-file.
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/yuyay
DB_USERNAME=yuyay
DB_PASSWORD=yuyay

# Mínimo 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-bytes-0123456789
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3000,http://localhost:19006

ADMIN_EMAIL=admin@yuyay.app
ADMIN_PASSWORD=cambiar-en-produccion
ADMIN_NAME=Administrador Yuyay

# Contraseña de los usuarios de demo (ana@demo.yuyay, bruno@demo.yuyay); solo se usa con el perfil demo.
DEMO_PASSWORD=

RESEND_API_KEY=
MAIL_FROM=Yuyay <onboarding@resend.dev>

# Archivos: en dev se guardan en disco (~/.yuyay/uploads). Con STORAGE_TYPE=s3 usan AWS_S3_BUCKET y AWS_REGION.
# STORAGE_TYPE=s3
# STORAGE_LOCAL_DIR=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# Clasificador de alcance de documentos (etiqueta el OCR como MEDICAL, REVIEW o NONMEDICAL). Apagado por defecto.
# Es el estado al iniciar: un administrador puede cambiarlo en caliente (PUT /api/v1/admin/document-scope) y al reiniciar vuelve a este valor.
DOCUMENT_SCOPE_ENABLED=false
# DOCUMENT_SCOPE_MIN_COVERAGE=0.50
# Un strike (NONMEDICAL) exige reconocer al menos esta fracción del texto; por debajo el resultado es REVIEW.
# DOCUMENT_SCOPE_STRIKE_MIN_COVERAGE=0.65
