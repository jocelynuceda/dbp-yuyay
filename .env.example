# Copiar a .env (nunca commitear .env). En EC2 se cargan con --env-file.
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/yuyay
DB_USERNAME=yuyay
DB_PASSWORD=yuyay

# Mínimo 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-bytes-0123456789
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Identificadores públicos de cliente OAuth aceptados como aud (separados por comas).
# Usa el cliente web configurado en la web y el SDK móvil. Vacío deshabilita Google.
GOOGLE_CLIENT_IDS=

APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3000,http://localhost:19006
# CORS_ALLOWED_ORIGIN_PATTERNS=https://yuyay-web.vercel.app,https://yuyay-frontend-*-jocelynucedas-projects.vercel.app

ADMIN_EMAIL=admin@yuyay.app
ADMIN_PASSWORD=cambiar-en-produccion
ADMIN_NAME=Administrador Yuyay

# Contraseña de los usuarios de demo (ana@demo.yuyay, bruno@demo.yuyay); solo se usa con el perfil demo.
DEMO_PASSWORD=

RESEND_API_KEY=
MAIL_FROM=Yuyay <onboarding@resend.dev>

# Sin RESEND_API_KEY, estas credenciales SMTP envían el correo (Gmail necesita una
# contraseña de aplicación, no la del correo). Con ambas vacías el correo solo se
# escribe en el log. Si usas Gmail, pon tu dirección también en MAIL_FROM.
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587

# Archivos: en dev se guardan en disco (~/.yuyay/uploads). Con STORAGE_TYPE=s3 usan AWS_S3_BUCKET y AWS_REGION.
# STORAGE_TYPE=s3
# STORAGE_LOCAL_DIR=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# Clasificador de alcance de documentos (etiqueta el OCR como MEDICAL, REVIEW o NONMEDICAL). Apagado por defecto.
# Es el estado al iniciar: un administrador puede cambiarlo en caliente (PUT /api/v1/admin/document-scope) y al reiniciar vuelve a este valor.
DOCUMENT_SCOPE_ENABLED=false
# DOCUMENT_SCOPE_MIN_COVERAGE=0.50
# Un strike (NONMEDICAL) exige reconocer al menos esta fracción del texto; por debajo el resultado es REVIEW.
# DOCUMENT_SCOPE_STRIKE_MIN_COVERAGE=0.65

# Límite de OCR por usuario (protege el costo de Textract y la cola de lectura). 0 apaga cada regla.
# Segundos mínimos entre un documento y el siguiente.
OCR_MIN_INTERVAL_SECONDS=5
# Documentos por usuario en 24 horas.
OCR_DAILY_LIMIT=30
# Documentos del usuario que pueden estar en proceso a la vez (últimos 10 minutos).
OCR_MAX_PENDING=3

# Recordatorios de citas: aviso el día anterior a SEND_AT en la zona indicada
REMINDERS_ENABLED=true
REMINDERS_ZONE=America/Lima
REMINDERS_SEND_AT=18:00

# Token de APIsPERU para contrastar nombres y apellidos (https://dniruc.apisperu.com).
# Sin token, las altas nuevas por correo y Google responden 503. Las cuentas existentes pueden ingresar.
RENIEC_API_TOKEN=
# Presupuesto diario UTC del registro: por dirección de origen y entre todos los orígenes.
REGISTRATION_DNI_PER_ORIGIN=5
REGISTRATION_DNI_DAILY_LIMIT=50
# Ajustar si Caddy llega a Tomcat por otra dirección. Incluir solo proxies controlados.
# YUYAY_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.17.0.1/32
# RENIEC_BASE_URL=https://dniruc.apisperu.com
# RENIEC_CONNECT_TIMEOUT_SECONDS=3
# RENIEC_READ_TIMEOUT_SECONDS=5

# Entrega del perfil a su titular (§3.4 del análisis). La edad mínima requiere revisión legal:
# el piso del reglamento de la Ley 29733 es 14 años. La fecha es declarada, no verificada.
# SELF_CLAIM_MIN_AGE=16
# CLAIM_INVITATION_VALID_DAYS=7
